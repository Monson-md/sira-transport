rules_version = '2';

// ===============================================================
// Modèle de données (sira_transport)
// ===============================================================
//
// users/{uid}
//   uid, name, phoneNumber, role ('client'|'driver_moto'|'driver_taxi'),
//   country, city, neighborhood, vehicleModel (drivers only),
//   rating (double, fixé à 5.0 à la création), ratingCount (int),
//   verificationStatus ('pending'|'approved'|'rejected' — seule une
//     Cloud Function admin peut le faire passer à 'approved'/'rejected'),
//   phoneVerified (bool — ne devient true que si le numéro Firebase Auth
//     vérifié correspond au numéro du profil),
//   fcmToken (string optionnel — dernier token FCM connu de l'appareil,
//     mis à jour par NotificationService, aucune règle dédiée : couvert
//     par la règle update générale sur les champs non verrouillés).
//
// rides/{rideId}
//   clientId, clientName, clientPhone, type ('colis'|'passager'),
//   departureNeighborhood, departureLandmark, arrivalNeighborhood,
//   arrivalLandmark, offeredPrice (int FCFA), status
//   ('pending'|'accepted'|'completed'|'cancelled'), driverId/driverName/
//   driverPhone, vehicleType ('moto'|'taxi'|'any'), country, city,
//   platformFee (int, 0 tant que la V2 payante n'existe pas),
//   createdAt/acceptedAt/completedAt/cancelledAt (Timestamp, toujours
//   FieldValue.serverTimestamp() côté client).
//
// rides/{rideId}/messages/{messageId}
//   senderId, text (string, 1 à 1000 caractères), createdAt (Timestamp,
//   toujours FieldValue.serverTimestamp() côté client). Lecture/écriture
//   réservées au client et au chauffeur de la course, uniquement tant
//   qu'elle est 'accepted'.
//
// ratings/{rideId}
//   rideId, clientId, driverId, stars (int, 1 à 5), createdAt (Timestamp,
//   toujours FieldValue.serverTimestamp() côté client). Un seul document
//   par course (id = rideId), créé uniquement par le client de la course
//   une fois 'completed', jamais modifiable ensuite. rating/ratingCount
//   du chauffeur sont recalculés par une Cloud Function déclenchée à la
//   création de ce document, jamais depuis l'app.
//
// driver_documents/{docId}
//   driverId, type ('identity'|'license'|'vehicle_registration'|
//   'vehicle_photo'), storagePath, status ('pending_review'|'approved'|
//   'rejected' — modifiable uniquement par une Cloud Function admin),
//   uploadedAt (Timestamp).
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Profil de l'appelant. Coûte une lecture Firestore supplémentaire à
    // chaque évaluation qui l'utilise — accepté ici pour pouvoir vérifier
    // rôle/ville/pays sans les faire confirmer par le client lui-même.
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isDriverRole(role) {
      return role in ['driver_moto', 'driver_taxi'];
    }

    function approvedDriver() {
      return signedIn()
        && isDriverRole(me().role)
        && me().verificationStatus == 'approved';
    }

    function isNonEmptyString(v) {
      return v is string && v.size() > 0;
    }

    // Le badge "numéro vérifié" ne peut être posé que si le token d'auth
    // (rafraîchi après linkWithCredential) prouve un numéro vérifié
    // identique à celui du profil. Il retombe à false si le client change
    // son numéro (on ne garde jamais un badge pour un numéro qui n'a plus
    // été vérifié), et ne peut jamais être retiré autrement.
    function phoneVerifiedChangeIsValid() {
      return request.resource.data.phoneVerified == resource.data.phoneVerified
        || (request.resource.data.phoneVerified == true
            && request.auth.token.phone_number == request.resource.data.phoneNumber)
        || (request.resource.data.phoneVerified == false
            && request.resource.data.phoneNumber != resource.data.phoneNumber);
    }

    // ---------------- users ----------------
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;

      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.uid == uid
                    && request.resource.data.role in ['client', 'driver_moto', 'driver_taxi']
                    && isNonEmptyString(request.resource.data.name)
                    && isNonEmptyString(request.resource.data.phoneNumber)
                    && isNonEmptyString(request.resource.data.country)
                    && isNonEmptyString(request.resource.data.city)
                    && isNonEmptyString(request.resource.data.neighborhood)
                    && (isDriverRole(request.resource.data.role)
                        ? isNonEmptyString(request.resource.data.vehicleModel)
                        : request.resource.data.vehicleModel == null)
                    && request.resource.data.rating == 5.0
                    && request.resource.data.ratingCount == 0
                    && request.resource.data.phoneVerified == false
                    && request.resource.data.verificationStatus ==
                        (isDriverRole(request.resource.data.role) ? 'pending' : 'approved');

      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.verificationStatus == resource.data.verificationStatus
                    && request.resource.data.rating == resource.data.rating
                    && request.resource.data.ratingCount == resource.data.ratingCount
                    && phoneVerifiedChangeIsValid();

      allow delete: if false;
    }

    // ---------------- rides ----------------
    match /rides/{rideId} {
      allow create: if signedIn()
                    && request.resource.data.clientId == request.auth.uid
                    && request.resource.data.clientName == me().name
                    && request.resource.data.clientPhone == me().phoneNumber
                    && request.resource.data.status == 'pending'
                    && request.resource.data.driverId == null
                    && request.resource.data.driverName == null
                    && request.resource.data.driverPhone == null
                    && request.resource.data.platformFee == 0
                    && request.resource.data.offeredPrice is int
                    && request.resource.data.offeredPrice >= 100
                    && request.resource.data.type in ['colis', 'passager']
                    && request.resource.data.vehicleType in ['moto', 'taxi', 'any']
                    && isNonEmptyString(request.resource.data.departureNeighborhood)
                    && isNonEmptyString(request.resource.data.departureLandmark)
                    && isNonEmptyString(request.resource.data.arrivalNeighborhood)
                    && isNonEmptyString(request.resource.data.arrivalLandmark)
                    && isNonEmptyString(request.resource.data.country)
                    && isNonEmptyString(request.resource.data.city)
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.acceptedAt == null
                    && request.resource.data.completedAt == null
                    && request.resource.data.cancelledAt == null;

      allow read: if signedIn() && (
                       resource.data.clientId == request.auth.uid
                    || resource.data.driverId == request.auth.uid
                    || (approvedDriver()
                        && resource.data.status == 'pending'
                        && resource.data.country == me().country
                        && resource.data.city == me().city)
                  );

      // Acceptation par un chauffeur vérifié : premier arrivé, premier
      // servi — la condition resource.data.status == 'pending' est ce qui
      // empêche deux chauffeurs de accepter la même course (à combiner
      // côté client avec une transaction, cf. RideService.acceptRide).
      allow update: if approvedDriver()
                    && resource.data.status == 'pending'
                    && request.resource.data.status == 'accepted'
                    && request.resource.data.driverId == request.auth.uid
                    && request.resource.data.driverName == me().name
                    && request.resource.data.driverPhone == me().phoneNumber
                    && request.resource.data.acceptedAt == request.time
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['status', 'driverId', 'driverName', 'driverPhone', 'acceptedAt']);

      // Fin de course par le chauffeur assigné.
      allow update: if signedIn()
                    && resource.data.driverId == request.auth.uid
                    && resource.data.status == 'accepted'
                    && request.resource.data.status == 'completed'
                    && request.resource.data.completedAt == request.time
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['status', 'completedAt']);

      // Annulation par le client, tant que personne n'a accepté.
      allow update: if signedIn()
                    && resource.data.clientId == request.auth.uid
                    && resource.data.status == 'pending'
                    && request.resource.data.status == 'cancelled'
                    && request.resource.data.cancelledAt == request.time
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['status', 'cancelledAt']);

      // Le client augmente son offre pendant l'attente, pour attirer un
      // chauffeur — jamais à la baisse, jamais après qu'un chauffeur ait
      // accepté, et rien d'autre que offeredPrice ne bouge.
      allow update: if signedIn()
                    && resource.data.clientId == request.auth.uid
                    && resource.data.status == 'pending'
                    && request.resource.data.status == 'pending'
                    && request.resource.data.offeredPrice is int
                    && request.resource.data.offeredPrice > resource.data.offeredPrice
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['offeredPrice']);

      allow delete: if false;
    }

    // ---------------- rides/{rideId}/messages ----------------
    match /rides/{rideId}/messages/{messageId} {
      function ride() {
        return get(/databases/$(database)/documents/rides/$(rideId)).data;
      }

      function isRideParty() {
        return signedIn()
          && (ride().clientId == request.auth.uid || ride().driverId == request.auth.uid);
      }

      allow read: if isRideParty();

      allow create: if isRideParty()
                    && ride().status == 'accepted'
                    && request.resource.data.senderId == request.auth.uid
                    && isNonEmptyString(request.resource.data.text)
                    && request.resource.data.text.size() <= 1000
                    && request.resource.data.createdAt == request.time;

      allow update: if false;
      allow delete: if false;
    }

    // ---------------- ratings ----------------
    match /ratings/{rideId} {
      function ratedRide() {
        return get(/databases/$(database)/documents/rides/$(rideId)).data;
      }

      allow read: if signedIn()
                  && (ratedRide().clientId == request.auth.uid
                      || ratedRide().driverId == request.auth.uid);

      // Un seul avis par course : le document est identifié par rideId et
      // aucune modification n'est permise ensuite (allow update: false
      // plus bas), donc une seconde tentative échoue systématiquement.
      allow create: if signedIn()
                    && ratedRide().status == 'completed'
                    && ratedRide().clientId == request.auth.uid
                    && request.resource.data.rideId == rideId
                    && request.resource.data.clientId == request.auth.uid
                    && request.resource.data.driverId == ratedRide().driverId
                    && request.resource.data.stars is int
                    && request.resource.data.stars >= 1
                    && request.resource.data.stars <= 5
                    && request.resource.data.createdAt == request.time;

      // rating/ratingCount du chauffeur ne sont recalculés que par la
      // Cloud Function onRatingCreated (Admin SDK, hors de ces règles).
      allow update: if false;
      allow delete: if false;
    }

    // ---------------- driver_documents ----------------
    match /driver_documents/{docId} {
      allow read: if signedIn() && (resource.data.driverId == request.auth.uid || isAdmin());

      allow create: if signedIn()
                    && request.resource.data.driverId == request.auth.uid
                    && isDriverRole(me().role)
                    && request.resource.data.type in
                        ['identity', 'license', 'vehicle_registration', 'vehicle_photo']
                    && isNonEmptyString(request.resource.data.storagePath)
                    && request.resource.data.status == 'pending_review'
                    && request.resource.data.uploadedAt == request.time;

      // Le passage à 'approved'/'rejected' ne se fait que par une Cloud
      // Function admin (Admin SDK, qui n'est pas soumis à ces règles).
      allow update: if false;
      allow delete: if false;
    }
  }
}

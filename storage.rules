rules_version = '2';

// Fichiers des pièces chauffeur, uploadés par DriverDocumentsService vers
// driver_documents/{driverId}/{type}-{timestamp}.jpg — cf. firestore.rules
// pour la collection driver_documents qui référence ces fichiers.
service firebase.storage {
  match /b/{bucket}/o {
    match /driver_documents/{driverId}/{fileName} {
      allow read: if request.auth != null
                  && (request.auth.uid == driverId || request.auth.token.admin == true);

      allow write: if request.auth != null && request.auth.uid == driverId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      allow delete: if false;
    }

    // Tout le reste du bucket est fermé par défaut.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
